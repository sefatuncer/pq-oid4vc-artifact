// PQ-OID4VC Step 1 — trust dependency graph (draft, 24.09.2026)
// Arrow direction = verification flow: A -> B, "A is used in the verification of B".
// Node shape/colour = channel class: pinned (grey), fetched (blue), conveyed (orange), transport (green).
// Edge style: solid = object signature/certificate chain; dashed = transport (TLS) or digest binding.
// Txxx in the labels = rows of traceability/izlenebilirlik.csv. No rendering needed.
digraph guven_bagimliligi {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, labelloc=t,
         label="OpenID4VC/EUDI trust dependency — 13 artefacts, channel classes (Step 1 draft)"];
  node  [fontname="Helvetica", fontsize=10, style="filled", shape=box];
  edge  [fontname="Helvetica", fontsize=9];

  subgraph cluster_sab {
    label="Pinned anchors"; style=dashed; color="#6b7280";
    OJEU  [label="OJEU digests\n(LOTL signer + channel certificate)\nT001,T002,T029", fillcolor="#e5e7eb", shape=cylinder];
    ROOTS [label="WebPKI root store\nT313", fillcolor="#e5e7eb", shape=cylinder];
    TMC   [label="Type Metadata cache\n(keyed by digest, indefinite)\nT093", fillcolor="#e5e7eb", shape=cylinder];
  }

  subgraph cluster_cek {
    label="Fetched (from an authorised source)"; style=dashed; color="#1d4ed8";
    LOTL [label="A01 LOTL\nXAdES; rsa-sha512 (measured)\nwindow <= 6 months (T010)", fillcolor="#dbeafe"];
    TL   [label="A02 national TL\nXAdES-B-B, single ds:Signature (T016)\n<= 6 months", fillcolor="#dbeafe"];
    LOTE [label="A02 EUDI LoTEs\ncompact JAdES-B, single signature (T023-T025)\nPID | wallet | WRPAC | WRPRC | PuB-EAA\n<= 6 months (T021)", fillcolor="#dbeafe"];
    SLT  [label="A08 status list token\nsignature or MAC (T145)\nexp/ttl undefined (T148,T149,T163)", fillcolor="#dbeafe"];
    IMD  [label="A05 issuer metadata\nunsigned by default (T071)\nsigned: x5c, exp optional (T076,T084)", fillcolor="#dbeafe"];
    TMD  [label="A06 Type Metadata\nunsigned; vct#integrity (T090)", fillcolor="#dbeafe"];
    CRL  [label="Access CA CRL/OCSP\n(T255, T256)", fillcolor="#dbeafe"];
    JVI  [label="JWT VC Issuer Metadata / JWK Set\nHTTPS only (T309-T311)", fillcolor="#dbeafe"];
  }

  subgraph cluster_akt {
    label="Conveyed (brought by the presenter)"; style=dashed; color="#c2410c";
    CA   [label="A03 CA intermediate certificates (x5c)\nanchor forbidden in x5c (T043)", fillcolor="#ffedd5"];
    ISC  [label="A04 issuer certificate (x5c leaf)\n(T042)", fillcolor="#ffedd5"];
    CRED [label="A07 credential (SD-JWT VC)\nexp optional (T118); <=24 h option (T175)", fillcolor="#ffedd5"];
    KB   [label="A10 KB-JWT + WSCD cnf key\niat window undefined (T212)", fillcolor="#ffedd5"];
    WUA  [label="A09 WIA (<24 h, T204) / KA\nonly to the issuer (T399,T400)", fillcolor="#ffedd5"];
    RPC  [label="A11 RP access (WRPAC) + registration (WRPRC) cert.\nby value (T252)", fillcolor="#ffedd5"];
    REQ  [label="A12 OID4VP request object\nunsigned / signed / multi-signed (T281)\nverification discretionary with the DC API (T268)", fillcolor="#ffedd5"];
  }

  TLS [label="A13 TLS server certificate\nBCP195, classical (T302-T305)", fillcolor="#dcfce7", shape=hexagon];

  // --- object signature / certificate chain (solid) ---
  OJEU -> LOTL [label="signer digest"];
  OJEU -> LOTE [label="anchor (TLPub_07)"];
  LOTL -> TL   [label="TL signer certificates\n(43 pointers)"];
  TL   -> CA   [label="QEAA anchor"];
  LOTE -> CA   [label="PID/PuB-EAA anchor"];
  CA   -> ISC  [label="signs"];
  ISC  -> CRED [label="signs"];
  CRED -> KB   [label="cnf (T218)"];
  CRED -> SLT  [label="status uri/idx"];
  LOTE -> SLT  [label="PID/Revocation anchor (T026)"];
  CA   -> SLT  [label="delegation, EKU (T159-T161)", style=dotted];
  LOTE -> WUA  [label="wallet provider anchor"];
  LOTE -> RPC  [label="WRPAC/WRPRC anchor (T245)"];
  CRL  -> RPC  [label="revocation"];
  RPC  -> REQ  [label="signature with x5c (T240)"];
  IMD  -> RPC  [label="access/registration cert. by value (T087,T088)"];
  ISC  -> IMD  [label="signed metadata (T084)", style=dotted];

  // --- digest / cache bindings (dashed) ---
  CRED -> TMD [label="vct#integrity", style=dashed];
  TMC  -> TMD [style=dashed];

  // --- transport (dashed, green) ---
  ROOTS -> TLS [label="anchor"];
  TLS -> IMD  [label="carries; only protection if unsigned", style=dashed, color="#15803d"];
  TLS -> SLT  [label="carries (TSL design does not rely on it, T157)", style=dashed, color="#15803d"];
  TLS -> TL   [label="carries", style=dashed, color="#15803d"];
  TLS -> TMD  [label="carries; only protection without a digest", style=dashed, color="#15803d"];
  TLS -> JVI  [label="only protection (channel substitution in fact)", style=dashed, color="#15803d"];
  TLS -> REQ  [label="request_uri / DC API origin (T282,T284)", style=dashed, color="#15803d"];
  JVI -> CRED [label="alternative key path", style=dashed];
  OJEU -> LOTL [label="download channel digest (T002)", style=dashed, color="#6b7280"];
}
