theory WeakestLink
begin

/*
  Pilot toy model (not the paper model).
  Question: after Q-day, does a PQ credential signature protect claims
  unforgeability if the channel conveying the issuer-specific
  "PQ required" expectation (the trust-list entry) is classical?

  Flags (-D):
    TL_PQ        trust-list signing key is post-quantum (never broken by CRQC)
    EXPECT_IN_TL trust-list entry conveys 'pq_required' for the issuer
    NO_COEXIST   issuer has retired its classical key (no dual signing)
*/

builtins: signing

restriction Equality:   "All x y #i. Eq(x,y) @i ==> x = y"
restriction Inequality: "All x #i. NotEq(x,x) @i ==> F"
restriction OnlyOnce:   "All x #i #j. OnlyOnce(x) @i & OnlyOnce(x) @j ==> #i = #j"

/* Q-day: from this point on a CRQC can break classical keys */
rule Qday:
  [ ] --[ OnlyOnce('qday'), QdayOlayi() ]-> [ !Qday() ]

/* Single trust-list operator; its public key is pinned at the verifier */
rule TL_Setup:
  [ Fr(~sktl) ]
  --[ OnlyOnce('tl') ]->
  [ !TLsk(~sktl), !TLpk(pk(~sktl)), Out(pk(~sktl)) ]

#ifdef TL_PQ
#else
rule CRQC_Break_TL:
  [ !TLsk(sk), !Qday() ] --[ BreakTL() ]-> [ Out(sk) ]
#endif

/* Issuer holds a PQ key and (during coexistence) a classical key */
rule Issuer_Setup:
  [ Fr(~skc), Fr(~skq) ]
  --[ IssuerSetup($I) ]->
  [ !IssC($I, ~skc), !IssQ($I, ~skq), Out(pk(~skc)), Out(pk(~skq)) ]

rule CRQC_Break_Issuer_Classical:
  [ !IssC(I, skc), !Qday() ] --[ BreakIss(I) ]-> [ Out(skc) ]

/* Trust-list entry binds issuer name to its keys and (optionally) the expectation */
#ifdef EXPECT_IN_TL
rule TL_Entry:
  let body = <'tlentry', I, pk(skc), pk(skq), 'pq_required'> in
  [ !TLsk(sktl), !IssC(I, skc), !IssQ(I, skq) ]
  --[ TLEntry(I) ]->
  [ Out(<body, sign(body, sktl)>) ]
#else
rule TL_Entry:
  let body = <'tlentry', I, pk(skc), pk(skq), 'none'> in
  [ !TLsk(sktl), !IssC(I, skc), !IssQ(I, skq) ]
  --[ TLEntry(I) ]->
  [ Out(<body, sign(body, sktl)>) ]
#endif

/* Issuance */
#ifdef NO_COEXIST
rule Issue:
  [ !IssQ(I, skq), Fr(~claims) ]
  --[ Issued(I, ~claims) ]->
  [ Out(<I, ~claims, sign(<I, ~claims>, skq)>) ]
#else
rule Issue:
  [ !IssC(I, skc), !IssQ(I, skq), Fr(~claims) ]
  --[ Issued(I, ~claims) ]->
  [ Out(<I, ~claims, sign(<I, ~claims>, skq)>),
    Out(<I, ~claims, sign(<I, ~claims>, skc)>) ]
#endif

/* Verifier: PQ path */
rule Verify_PQ:
  let tlbody = <'tlentry', I, pkc, pkq, exp> in
  [ !TLpk(pktl), In(<tlbody, tlsig>), In(<I, claims, sigq>) ]
  --[ Eq(verify(tlsig, tlbody, pktl), true),
      Eq(verify(sigq, <I, claims>, pkq), true),
      Accept(I, claims) ]->
  [ ]

/* Verifier: legacy classical path, allowed only if the trust list does not require PQ */
#ifdef NO_COEXIST
#else
rule Verify_Classical:
  let tlbody = <'tlentry', I, pkc, pkq, exp> in
  [ !TLpk(pktl), In(<tlbody, tlsig>), In(<I, claims, sigc>) ]
  --[ Eq(verify(tlsig, tlbody, pktl), true),
      Eq(verify(sigc, <I, claims>, pkc), true),
      NotEq(exp, 'pq_required'),
      Accept(I, claims) ]->
  [ ]
#endif

/* Sanity (H0-style): honest issuance and acceptance is reachable */
lemma executable:
  exists-trace "Ex I c #i #j. Issued(I, c) @i & Accept(I, c) @j"

/* Claims unforgeability, with a Q-day in the trace */
lemma claims_unforgeability:
  "All I c #j. Accept(I, c) @j ==> (Ex #i. Issued(I, c) @i & #i < #j)"

end
