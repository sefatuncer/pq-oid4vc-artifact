theory R7_Monotone
begin

/*
 * =====================================================================
 *  PQ-OID4VC | Adım 5A | kural şeması R7 — TEKDÜZE BEKLENTİ
 *  (M-f bileşen ablasyonu A3; M-f ↔ M-g; L-D1, L-D2; H3; G5'in zamanlı biçimi)
 * =====================================================================
 *  EN  A PQ-capable verifier resists downgrade and rollback of a migrating
 *      issuer's expectation iff the value it relies on at decision time is
 *      authentic and current and per entity: from an authoritative third party
 *      over a PQ-authenticated channel that is fresh (online) or pinned, or,
 *      offline, with sticky (monotone) verifier state plus key expiry at the
 *      announced sunset. A self-declared expectation learned on first contact
 *      (TOFU, M-g) cannot protect the first contact.
 *  TR  PQ yetenekli bir doğrulayıcı, göç eden bir ihraççının beklentisine
 *      yönelik downgrade ve geri almaya ancak şu durumda dayanır: karar anında
 *      dayandığı değer özgün, güncel ve varlık başınadır. Bu değer yetkili bir
 *      üçüncü taraftan, PQ ile doğrulanmış bir kanaldan, taze (çevrimiçi) ya da
 *      sabitlenmiş olarak gelir. Çevrimdışı durumda ise yapışkan (tekdüze)
 *      doğrulayıcı durumu ve ilan edilen sunset'te anahtar süresinin dolması
 *      gerekir. İlk temasta öğrenilen öz-beyanlı beklenti (TOFU, M-g) ilk
 *      teması koruyamaz.
 *
 *  Lifecycle of a migrating issuer I (encoded by restrictions, no state loops):
 *      Setup: expectation 'none' -> Migrate(I): 'pq_required' -> Sunset(I): 'retired'
 *  Issuance: classical credentials until Sunset, PQ credentials after Migrate
 *  (dual issuance in between). Legacy issuer L never migrates (keeps the
 *  classical path live and makes per-entity scope matter). Issuer public keys
 *  are pinned at verifiers (chain effects: R1/R5/M-h). Verifiers $V are PQ
 *  capable: PQ evidence is always acceptable; classical evidence only through
 *  the expectation gate of the chosen mechanism.
 *
 *  Mechanism
 *    (default) M-f  authoritative third party (TL/LoTE) states the expectation
 *    MG        M-g  self-declared: PQ credentials carry the issuer's own
 *                   "pq_required" declaration, cached by the verifier (TOFU)
 *  M-f channel mode (PER_ENTITY)
 *    PINNED    verifier configuration synchronised out of band (authentic, current)
 *    FRESH     online nonce-bound query to the source; the value is current at
 *              use time (restriction Freshness)
 *    (neither) offline signed objects <'exp', X, e>: authentic but replayable
 *  Components (A3 ablation)
 *    PQ_CHAN       source signing key is PQ (else classical, CRQC-breakable)
 *    PER_ENTITY    expectation per issuer (else one global value, 'none' while
 *                  any legacy issuer exists)
 *    MONOTONE      sticky verifier state: once 'pq_required'/'retired' is seen
 *                  for X, classical evidence for X is never accepted again
 *    SUNSET_CHECK  the classical key's certified validity ends at Sunset and
 *                  the verifier enforces it
 *  Unsupported combination: PINNED without PER_ENTITY.
 */

builtins: signing

restriction Equality:   "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Inequality: "All x #i. NotEq(x, x) @ #i ==> F"
restriction Unique:     "All x #i #j. Unique(x) @ #i & Unique(x) @ #j ==> #i = #j"

/* ---------------- lifecycle (authoritative state = event order) ---------------- */
restriction SunsetAfterMigrate:
  "All I #s. Sunset(I) @ #s ==> (Ex #m. Migrate(I) @ #m & #m < #s)"

/* honest reports of the current state (source, pin) */
restriction ReportNone:
  "All X #r. StateIs(X, 'none') @ #r ==> not (Ex #m. Migrate(X) @ #m & #m < #r)"
restriction ReportPQ:
  "All X #r. StateIs(X, 'pq_required') @ #r ==>
      (Ex #m. Migrate(X) @ #m & #m < #r) & not (Ex #s. Sunset(X) @ #s & #s < #r)"
restriction ReportRetired:
  "All X #r. StateIs(X, 'retired') @ #r ==> (Ex #s. Sunset(X) @ #s & #s < #r)"

/* honest issuance follows the lifecycle */
restriction ClassicalIssuanceUntilSunset:
  "All X #i. IssueClassical(X) @ #i ==> not (Ex #s. Sunset(X) @ #s & #s < #i)"
restriction PQIssuanceAfterMigrate:
  "All X #i. IssuePQ(X) @ #i ==> (Ex #m. Migrate(X) @ #m & #m < #i)"

/* ---------------- components ---------------- */
#ifdef FRESH
/* an authentic response is used before the issuer's state changes again */
restriction Freshness:
  "All X n e #r #u #ch. Respond(n, X, e) @ #r & UseResp(n) @ #u & StateChange(X) @ #ch
      ==> (#ch < #r) | (#u < #ch)"
#endif

#ifdef MONOTONE
restriction Sticky:
  "All V X c #k #j. SeenPQReq(V, X) @ #k & AcceptClassical(V, X, c) @ #j ==> #j < #k"
#endif

#ifdef SUNSET_CHECK
restriction ClassicalKeyExpiry:
  "All X #j. UseClKey(X) @ #j ==> not (Ex #s. Sunset(X) @ #s & #s < #j)"
#endif

/* ---------------- Q-day and CRQC ---------------- */
rule Qday:
    [ ] --[ Unique('qday'), QdayEv() ]-> [ !CRQC() ]

rule CRQC_Break_Issuer_Classical:
    [ !IssCl(X, k), !CRQC(), In(pk(k)) ] --[ Broken(<'iss_cl', X>) ]-> [ Out(k) ]

/* ---------------- issuers and lifecycle ---------------- */
rule Migrating_Issuer_Setup:
    [ Fr(~kc), Fr(~kq) ]
  --[ Unique(<'iss', $I>), MigratingIssuer($I) ]->
    [ !IssCl($I, ~kc), !IssPQ($I, ~kq), !PinCl($I, pk(~kc)), !PinPQ($I, pk(~kq)),
      Out(pk(~kc)), Out(pk(~kq)) ]

rule Legacy_Issuer_Setup:
    [ Fr(~kc) ]
  --[ Unique(<'iss', $L>), Legacy($L) ]->
    [ !IssCl($L, ~kc), !PinCl($L, pk(~kc)), Out(pk(~kc)) ]

rule Migrate:
    [ !IssPQ(I, kq) ] --[ Unique(<'migrate', I>), Migrate(I), StateChange(I) ]-> [ ]

rule Sunset:
    [ !IssPQ(I, kq) ] --[ Unique(<'sunset', I>), Sunset(I), StateChange(I) ]-> [ ]

rule Issue_Classical:
    let crb = <'cred', X, ~c, 'cl'> in
    [ !IssCl(X, kc), Fr(~c) ]
  --[ Issued(X, ~c), IssueClassical(X) ]->
    [ Out(<crb, sign(crb, kc)>) ]

rule Issue_PQ:
    let crb = <'cred', I, ~c, 'pq'> in
    [ !IssPQ(I, kq), Fr(~c) ]
  --[ Issued(I, ~c), IssuePQ(I) ]->
    [ Out(<crb, sign(crb, kq)>) ]

/* ---------------- expectation source (M-f, not pinned) ---------------- */
#ifdef not MG & not PINNED
rule Source_Setup:
    [ Fr(~ks) ] --[ Unique('src') ]-> [ !SrcSk(~ks), !SrcPin(pk(~ks)), Out(pk(~ks)) ]
#endif

#ifdef not MG & not PINNED & not PQ_CHAN
rule CRQC_Break_Source:
    [ !SrcSk(k), !CRQC(), In(pk(k)) ] --[ Broken('src') ]-> [ Out(k) ]
#endif

/* ---------------- verifier: PQ path ---------------- */
#ifdef MG
/* M-g: every PQ credential carries the issuer's own "pq_required" declaration */
rule Verify_PQ:
    let crb = <'cred', I, c, 'pq'> in
    [ !PinPQ(I, pkq), In(<crb, s>) ]
  --[ Eq(verify(s, crb, pkq), true), AcceptPQ($V, I, c), SeenPQReq($V, I) ]->
    [ ]
#endif

#ifdef not MG
rule Verify_PQ:
    let crb = <'cred', I, c, 'pq'> in
    [ !PinPQ(I, pkq), In(<crb, s>) ]
  --[ Eq(verify(s, crb, pkq), true), AcceptPQ($V, I, c) ]->
    [ ]
#endif

/* ---------------- verifier: classical path per mechanism ---------------- */
#ifdef MG
/* TOFU: no third-party gate; only the cached declaration (MONOTONE) can stop it */
rule Verify_Classical:
    let crb = <'cred', X, c, 'cl'> in
    [ !PinCl(X, pkc), In(<crb, s>) ]
  --[ Eq(verify(s, crb, pkc), true), UseClKey(X), AcceptClassical($V, X, c) ]->
    [ ]
#endif

#ifdef not MG & not PER_ENTITY
/* one global expectation, 'none' while any legacy issuer exists */
rule Publish_Global:
    let gb = <'exp_global', 'none'> in
    [ !SrcSk(k) ] --[ Unique('global') ]-> [ Out(<gb, sign(gb, k)>) ]

rule Verify_Classical:
    let gb  = <'exp_global', 'none'>
        crb = <'cred', X, c, 'cl'>
    in
    [ !SrcPin(pks), In(<gb, gs>), !PinCl(X, pkc), In(<crb, s>) ]
  --[ Eq(verify(gs, gb, pks), true), Eq(verify(s, crb, pkc), true),
      UsedGlobal(), UseClKey(X), AcceptClassical($V, X, c) ]->
    [ ]
#endif

#ifdef not MG & PER_ENTITY & PINNED
/* pinned: the verifier's configuration shows the current state at decision time */
rule Verify_Classical:
    let crb = <'cred', X, c, 'cl'> in
    [ !PinCl(X, pkc), In(<crb, s>) ]
  --[ Eq(verify(s, crb, pkc), true), StateIs(X, 'none'),
      UseClKey(X), AcceptClassical($V, X, c) ]->
    [ ]

rule Learn_Pinned_PQ:
    [ !PinPQ(I, pkq) ] --[ StateIs(I, 'pq_required'), SeenPQReq($V, I) ]-> [ ]

rule Learn_Pinned_Retired:
    [ !PinPQ(I, pkq) ] --[ StateIs(I, 'retired'), SeenPQReq($V, I) ]-> [ ]
#endif

#ifdef not MG & PER_ENTITY & FRESH & not PINNED
/* online: nonce-bound query to the authoritative source */
rule Verifier_Query:
    [ Fr(~n) ] --> [ Q($V, ~n, $X), Out(<'q', ~n, $X>) ]

rule Source_Respond_None:
    let rb = <'resp', n, X, 'none'> in
    [ !SrcSk(k), !PinCl(X, pkc), In(<'q', n, X>) ]
  --[ StateIs(X, 'none'), Respond(n, X, 'none') ]->
    [ Out(<rb, sign(rb, k)>) ]

rule Source_Respond_PQ:
    let rb = <'resp', n, I, 'pq_required'> in
    [ !SrcSk(k), !PinPQ(I, pkq), In(<'q', n, I>) ]
  --[ StateIs(I, 'pq_required'), Respond(n, I, 'pq_required') ]->
    [ Out(<rb, sign(rb, k)>) ]

rule Source_Respond_Retired:
    let rb = <'resp', n, I, 'retired'> in
    [ !SrcSk(k), !PinPQ(I, pkq), In(<'q', n, I>) ]
  --[ StateIs(I, 'retired'), Respond(n, I, 'retired') ]->
    [ Out(<rb, sign(rb, k)>) ]

rule Verify_Classical:
    let rb  = <'resp', n, X, 'none'>
        crb = <'cred', X, c, 'cl'>
    in
    [ Q(V, n, X), !SrcPin(pks), In(<rb, rs>), !PinCl(X, pkc), In(<crb, s>) ]
  --[ Eq(verify(rs, rb, pks), true), Eq(verify(s, crb, pkc), true),
      UseResp(n), UseClKey(X), AcceptClassical(V, X, c) ]->
    [ ]

rule Learn_Fresh:
    let rb = <'resp', n, X, e> in
    [ Q(V, n, X), !SrcPin(pks), In(<rb, rs>) ]
  --[ Eq(verify(rs, rb, pks), true), NotEq(e, 'none'), UseResp(n), SeenPQReq(V, X) ]->
    [ ]
#endif

#ifdef not MG & PER_ENTITY & not FRESH & not PINNED
/* offline: signed expectation objects, authentic but replayable */
rule Publish_None:
    let ob = <'exp', X, 'none'> in
    [ !SrcSk(k), !PinCl(X, pkc) ] --[ StateIs(X, 'none') ]-> [ Out(<ob, sign(ob, k)>) ]

rule Publish_PQ:
    let ob = <'exp', I, 'pq_required'> in
    [ !SrcSk(k), !PinPQ(I, pkq) ] --[ StateIs(I, 'pq_required') ]-> [ Out(<ob, sign(ob, k)>) ]

rule Publish_Retired:
    let ob = <'exp', I, 'retired'> in
    [ !SrcSk(k), !PinPQ(I, pkq) ] --[ StateIs(I, 'retired') ]-> [ Out(<ob, sign(ob, k)>) ]

rule Verify_Classical:
    let ob  = <'exp', X, 'none'>
        crb = <'cred', X, c, 'cl'>
    in
    [ !SrcPin(pks), In(<ob, os>), !PinCl(X, pkc), In(<crb, s>) ]
  --[ Eq(verify(os, ob, pks), true), Eq(verify(s, crb, pkc), true),
      UsedObject(X, 'none'), UseClKey(X), AcceptClassical($V, X, c) ]->
    [ ]

rule Learn_Object:
    let ob = <'exp', X, e> in
    [ !SrcPin(pks), In(<ob, os>) ]
  --[ Eq(verify(os, ob, pks), true), NotEq(e, 'none'), SeenPQReq($V, X) ]->
    [ ]
#endif

/* ================= health lemmas (H0) ================= */

lemma executable:
  exists-trace
  "Ex V I c #m #j. Migrate(I) @ #m & AcceptPQ(V, I, c) @ #j"

lemma executable_legacy:
  exists-trace
  "Ex V L c #l #j. Legacy(L) @ #l & AcceptClassical(V, L, c) @ #j"

/* the gate is open for a migrating issuer before it migrates */
lemma executable_pre_migration:
  exists-trace
  "Ex V I c #s #j. MigratingIssuer(I) @ #s & AcceptClassical(V, I, c) @ #j
                 & not (Ex #m. Migrate(I) @ #m)"

lemma executable_lifecycle:
  exists-trace
  "Ex V I c #m #s #j. Migrate(I) @ #m & Sunset(I) @ #s & AcceptPQ(V, I, c) @ #j & #s < #j"

/* a verifier can learn a non-'none' expectation (non-vacuity of no_rollback) */
lemma executable_learn:
  exists-trace
  "Ex V I #k. SeenPQReq(V, I) @ #k"

/* ================= security goals ================= */

/* no classical-only acceptance of an issuer after it migrated (covers first contact) */
lemma G5_migrated:
  "All V I c #m #j. Migrate(I) @ #m & AcceptClassical(V, I, c) @ #j & #m < #j ==> F"

/* G5, timed form: no classical-only acceptance after the declared sunset */
lemma G5_timed:
  "All V I c #s #j. Sunset(I) @ #s & AcceptClassical(V, I, c) @ #j & #s < #j ==> F"

/* once a verifier has seen 'pq_required' / 'retired' for I it never goes back */
lemma no_rollback:
  "All V I c #k #j. SeenPQReq(V, I) @ #k & AcceptClassical(V, I, c) @ #j & #k < #j ==> F"

/* information (L-D1): a verifier that never saw I's expectation accepts
   classical evidence of I after migration (first-contact downgrade) */
lemma first_contact_downgrade:
  exists-trace
  "Ex V I c #m #j. Migrate(I) @ #m & AcceptClassical(V, I, c) @ #j & #m < #j
                 & not (Ex #k. SeenPQReq(V, I) @ #k)"

/* ================= mutation / attribution lemmas ================= */

#ifdef not MG & not PINNED & not PQ_CHAN
lemma M_source_key_broken:
  exists-trace
  "Ex V I c #m #j #b. Migrate(I) @ #m & AcceptClassical(V, I, c) @ #j & #m < #j & Broken('src') @ #b"
#endif

#ifdef not MG & PER_ENTITY & not FRESH & not PINNED
/* replay of an authentic but stale 'none' object; no CRQC needed (S1) */
lemma M_stale_object:
  exists-trace
  "Ex V I c #m #j. Migrate(I) @ #m & AcceptClassical(V, I, c) @ #j & UsedObject(I, 'none') @ #j
                 & #m < #j & not (Ex x #b. Broken(x) @ #b)"
#endif

#ifdef not MG & not PER_ENTITY
lemma M_global_expectation:
  exists-trace
  "Ex V I c #m #j. Migrate(I) @ #m & AcceptClassical(V, I, c) @ #j & UsedGlobal() @ #j & #m < #j"
#endif

#ifdef not MONOTONE
lemma M_rollback:
  exists-trace
  "Ex V I c #k #j. SeenPQReq(V, I) @ #k & AcceptClassical(V, I, c) @ #j & #k < #j"
#endif

#ifdef not SUNSET_CHECK
lemma M_after_sunset:
  exists-trace
  "Ex V I c #s #j. Sunset(I) @ #s & AcceptClassical(V, I, c) @ #j & #s < #j"
#endif

end
