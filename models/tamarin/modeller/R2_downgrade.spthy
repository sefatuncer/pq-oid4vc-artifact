theory R2_Downgrade
begin

/*
 * =====================================================================
 *  PQ-OID4VC | Adım 4 | Katman 2 kural şeması R2 — DOWNGRADE
 * =====================================================================
 *  EN  During coexistence the same issuer holds a classical and a PQ key,
 *      both valid, and the verifier's default policy is any-valid (P0).
 *      Unless the verifier holds an AUTHENTICATED per-issuer "PQ required"
 *      expectation, (i) classical-only evidence of a migrated issuer is
 *      accepted (G5, downgrade), and (ii) after Q-day a credential forged
 *      with the extracted classical key is accepted (G1). With an
 *      authenticated expectation neither happens. Without coexistence
 *      (classical key retired) no expectation is needed.
 *  TR  Birlikte yaşama döneminde aynı ihraççının klasik ve PQ anahtarı
 *      birlikte geçerlidir; doğrulayıcının varsayılan politikası "en az
 *      biri geçerli"dir (P0). Doğrulayıcıda kimliği doğrulanmış, ihraççı
 *      başına bir "PQ zorunlu" beklentisi yoksa (i) göç etmiş ihraççının
 *      yalnız klasik kanıtı kabul edilir (G5), (ii) Q-day'den sonra
 *      çıkarılan klasik anahtarla sahtelenmiş kimlik bilgisi kabul edilir
 *      (G1). Kimliği doğrulanmış beklenti varsa ikisi de olmaz. Birlikte
 *      yaşama yoksa (klasik anahtar emekli) beklenti gerekmez.
 *
 *  Entities
 *    migrated issuer I : PQ key (+ classical key while coexisting),
 *                        declared expectation 'pq_required'
 *    legacy issuer L   : classical key only, expectation 'none'. It keeps
 *                        the classical path live in every variant, so a
 *                        "verified" result is not obtained by disabling
 *                        the classical path globally (per-entity scope).
 *    verifier          : paths Verify_PQ and Verify_Classical.
 *  Issuer public keys reach the verifier authentically (no chain here;
 *  chains are R1/R5), so the only attack surface is the path choice.
 *
 *  Flags (-D=...)
 *    NO_COEXIST     migrated issuers have retired their classical key
 *    EXPECT_AUTH    verifier holds the expectation from an authenticated
 *                   source (provisioned configuration)
 *    EXPECT_UNAUTH  verifier reads the expectation from an unauthenticated
 *                   field (capability negotiation, M-a class)
 *    (neither)      no expectation at all (policy P0 any-valid)
 *  Datalog: coexist(cred) <=> not NO_COEXIST;
 *           convey(cfg,cred) <=> EXPECT_AUTH  (cfg unforgeable);
 *           convey(net,cred) <=> EXPECT_UNAUTH (net forgeable).
 *
 *  Protected : -D=EXPECT_AUTH                         -> G1, G5 verified
 *  Mutants   : -D=EXPECT_UNAUTH  (authentication removed) -> G1, G5 falsified
 *              no flag           (expectation removed)    -> G1, G5 falsified
 */

builtins: signing

restriction Equality:   "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Inequality: "All x #i. NotEq(x, x) @ #i ==> F"
restriction Unique:     "All x #i #j. Unique(x) @ #i & Unique(x) @ #j ==> #i = #j"

/* ---------------- Q-day ---------------- */
rule Qday:
    [ ] --[ Unique('qday'), QdayEv() ]-> [ !CRQC() ]

/* ---------------- migrated issuer ---------------- */
#ifdef NO_COEXIST
rule Migrated_Issuer_Setup:
    [ Fr(~skq) ]
  --[ Unique(<'iss', $I>), Migrated($I) ]->
    [ !IssPQSk($I, ~skq), !IssPQPk($I, pk(~skq)),
      !ExpectOf($I, 'pq_required'), Out(pk(~skq)) ]

rule Issue_Migrated:
    let crb = <'cred', I, ~c> in
    [ !IssPQSk(I, skq), Fr(~c) ]
  --[ Issued(I, ~c) ]->
    [ Out(<crb, sign(crb, skq)>) ]
#endif

#ifdef not NO_COEXIST
rule Migrated_Issuer_Setup:
    [ Fr(~skq), Fr(~skc) ]
  --[ Unique(<'iss', $I>), Migrated($I) ]->
    [ !IssPQSk($I, ~skq), !IssPQPk($I, pk(~skq)),
      !IssClSk($I, ~skc), !IssClPk($I, pk(~skc)),
      !ExpectOf($I, 'pq_required'), Out(pk(~skq)), Out(pk(~skc)) ]

/* dual issuance during coexistence: same claims, one PQ and one classical signature */
rule Issue_Migrated:
    let crb = <'cred', I, ~c> in
    [ !IssPQSk(I, skq), !IssClSk(I, skc), Fr(~c) ]
  --[ Issued(I, ~c) ]->
    [ Out(<crb, sign(crb, skq)>), Out(<crb, sign(crb, skc)>) ]
#endif

/* ---------------- legacy issuer (never migrated) ---------------- */
rule Legacy_Issuer_Setup:
    [ Fr(~skc) ]
  --[ Unique(<'iss', $L>), Legacy($L) ]->
    [ !IssClSk($L, ~skc), !IssClPk($L, pk(~skc)),
      !ExpectOf($L, 'none'), Out(pk(~skc)) ]

rule Issue_Legacy:
    let crb = <'cred', L, ~c> in
    [ !IssClSk(L, skc), !ExpectOf(L, 'none'), Fr(~c) ]
  --[ Issued(L, ~c) ]->
    [ Out(<crb, sign(crb, skc)>) ]

/* ---------------- CRQC: only classical issuer keys are breakable ---------------- */
rule CRQC_Break_Issuer_Classical:
    [ !IssClSk(X, sk), !CRQC(), In(pk(sk)) ]
  --[ Broken(<'iss_classical', X>) ]->
    [ Out(sk) ]

/* ---------------- expectation conveyance ---------------- */
#ifdef EXPECT_AUTH
/* authentic out-of-band provisioning into the verifier configuration */
rule Provision_Expectation:
    [ !ExpectOf(X, e) ] --> [ !VerifierExpect(X, e) ]
#endif

#ifdef EXPECT_UNAUTH & not EXPECT_AUTH
/* expectation announced in an unauthenticated field; the attacker may alter it */
rule Announce_Expectation:
    [ !ExpectOf(X, e) ] --> [ Out(<'expect', X, e>) ]
#endif

/* ---------------- verifier ---------------- */
rule Verify_PQ:
    let crb = <'cred', I, c> in
    [ !IssPQPk(I, pkq), In(<crb, s>) ]
  --[ Eq(verify(s, crb, pkq), true), Accept(I, c), AcceptVia(I, c, 'pq') ]->
    [ ]

#ifdef EXPECT_AUTH
rule Verify_Classical:
    let crb = <'cred', I, c> in
    [ !IssClPk(I, pkc), !VerifierExpect(I, e), In(<crb, s>) ]
  --[ NotEq(e, 'pq_required'), Eq(verify(s, crb, pkc), true),
      Accept(I, c), AcceptVia(I, c, 'classical'), UsedExpectation(I, e) ]->
    [ ]
#endif

#ifdef EXPECT_UNAUTH & not EXPECT_AUTH
rule Verify_Classical:
    let crb = <'cred', I, c> in
    [ !IssClPk(I, pkc), In(<'expect', I, e>), In(<crb, s>) ]
  --[ NotEq(e, 'pq_required'), Eq(verify(s, crb, pkc), true),
      Accept(I, c), AcceptVia(I, c, 'classical'), UsedExpectation(I, e) ]->
    [ ]
#endif

#ifdef not EXPECT_AUTH & not EXPECT_UNAUTH
rule Verify_Classical:
    let crb = <'cred', I, c> in
    [ !IssClPk(I, pkc), In(<crb, s>) ]
  --[ Eq(verify(s, crb, pkc), true),
      Accept(I, c), AcceptVia(I, c, 'classical') ]->
    [ ]
#endif

/* ================= health lemmas (H0) ================= */

lemma executable:
  exists-trace
  "Ex I c #m #i #j. Migrated(I) @ #m & Issued(I, c) @ #i & AcceptVia(I, c, 'pq') @ #j"

/* the classical path is live for legacy issuers in every variant */
lemma executable_legacy:
  exists-trace
  "Ex L c #l #i #j. Legacy(L) @ #l & Issued(L, c) @ #i & AcceptVia(L, c, 'classical') @ #j"

lemma executable_post_qday:
  exists-trace
  "Ex I c #q #m #i #j. QdayEv() @ #q & Migrated(I) @ #m & Issued(I, c) @ #i
                     & Accept(I, c) @ #j & #q < #j"

lemma attack_needs_crqc:
  "All I c #m #j. Migrated(I) @ #m & Accept(I, c) @ #j ==>
      (Ex #i. Issued(I, c) @ #i & #i < #j) | (Ex k #b. Broken(k) @ #b & #b < #j)"

/* ================= security goals ================= */

/* G1 for migrated issuers (legacy issuers are classical by definition) */
lemma G1_claims_unforgeability:
  "All I c #m #j. Migrated(I) @ #m & Accept(I, c) @ #j ==> (Ex #i. Issued(I, c) @ #i & #i < #j)"

/* G5 (untimed form): a migrated issuer is never accepted on classical-only evidence.
   The legacy-window / sunset dimension is R6-R7. */
lemma G5_no_classical_acceptance:
  "All I c #m #j. Migrated(I) @ #m & AcceptVia(I, c, 'classical') @ #j ==> F"

/* informative (H3): the downgrade needs no CRQC at all when the expectation is
   missing or unauthenticated; expected: trace exists iff G5 is falsified */
lemma S1_downgrade_trace:
  exists-trace
  "Ex I c #m #j. Migrated(I) @ #m & AcceptVia(I, c, 'classical') @ #j
               & not (Ex #q. QdayEv() @ #q)"

/* ================= mutation lemmas ================= */
#ifdef EXPECT_UNAUTH & not EXPECT_AUTH & not NO_COEXIST
lemma M_expectation_unauthenticated:
  exists-trace
  "Ex I c #m #j #b. Migrated(I) @ #m & Accept(I, c) @ #j & UsedExpectation(I, 'none') @ #j
                  & Broken(<'iss_classical', I>) @ #b & not (Ex #i. Issued(I, c) @ #i)"
#endif

#ifdef not EXPECT_UNAUTH & not EXPECT_AUTH & not NO_COEXIST
lemma M_expectation_absent:
  exists-trace
  "Ex I c #m #j #b. Migrated(I) @ #m & AcceptVia(I, c, 'classical') @ #j
                  & Broken(<'iss_classical', I>) @ #b & not (Ex #i. Issued(I, c) @ #i)"
#endif

end
