    let isb = <'iss_cert', I, pkI, 'pq'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, e), !Anchor(A, pkA, aA), In(<isb, s2>), In(<crb, s3>) ]
  --[ NotEq(e, 'none'), Eq(verify(s2, isb, pkA), true), Eq(verify(s3, crb, pkI), true),
      ExpUse(sid), Accept(V, I, c), AcceptPQ(V, I, c), EdgeAlg(V, I, c, aA) ]->
