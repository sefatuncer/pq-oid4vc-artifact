theory Ornek_CERCEVE_001879
begin

/*
 * PQ-OID4VC | teknik kapı (ÖK §2F) | kapi örneği CERCEVE-001879 — cevir.py ile üretildi; elle değiştirme.
 * hedef G3 (a08_durum), tür bir-eksik, hücre birincil|g3|f1|hizli|onbellek|p4
 * Çeviri kuralları: cevir.py başlığı. Girdi: atama (pq), kenarlar (tanitici), sabitleme,
 * faz (klasik alternatif), pencere (kırılabilirlik), taşıyıcılar, politika. ASP çıktıları okunmadı.
 */

builtins: signing

restriction Equality: "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Unique:   "All x #i #j. Unique(x) @ #i & Unique(x) @ #j ==> #i = #j"

rule Qday:
    [ ] --[ Unique('qday'), QdayEv() ]-> [ !CRQC() ]

/* ---------------- artefakt imzacı anahtarları (R1/R5; birlikte yaşamada ikinci klasik anahtar: R2) ---------------- */
rule Setup_a01_lotl:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a01_lotl') ]-> [ !Sk('a01_lotl', 'main', ~km), !Sk('a01_lotl', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a01_lotl_alt:
    [ !Sk('a01_lotl', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a01_lotl_alt') ]-> [ Out(k) ]
rule Setup_a02_lote_pid:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a02_lote_pid') ]-> [ !Sk('a02_lote_pid', 'main', ~km), !Sk('a02_lote_pid', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a02_lote_pid_alt:
    [ !Sk('a02_lote_pid', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a02_lote_pid_alt') ]-> [ Out(k) ]
rule Setup_a02_tl:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a02_tl') ]-> [ !Sk('a02_tl', 'main', ~km), !Sk('a02_tl', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a02_tl_alt:
    [ !Sk('a02_tl', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a02_tl_alt') ]-> [ Out(k) ]
rule Setup_a03_ca:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a03_ca') ]-> [ !Sk('a03_ca', 'main', ~km), !Sk('a03_ca', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a03_ca_alt:
    [ !Sk('a03_ca', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a03_ca_alt') ]-> [ Out(k) ]
rule Setup_a04_ihr:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a04_ihr') ]-> [ !Sk('a04_ihr', 'main', ~km), !Sk('a04_ihr', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a04_ihr_alt:
    [ !Sk('a04_ihr', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a04_ihr_alt') ]-> [ Out(k) ]
rule Setup_a05_meta:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a05_meta') ]-> [ !Sk('a05_meta', 'main', ~km), !Sk('a05_meta', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a05_meta_alt:
    [ !Sk('a05_meta', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a05_meta_alt') ]-> [ Out(k) ]
rule Setup_a08_durum:
    [ Fr(~km), Fr(~ka) ] --[ Unique('setup_a08_durum') ]-> [ !Sk('a08_durum', 'main', ~km), !Sk('a08_durum', 'alt', ~ka), Out(pk(~km)), Out(pk(~ka)) ]
rule Break_a08_durum_alt:
    [ !Sk('a08_durum', 'alt', k), !CRQC(), In(pk(k)) ] --[ Broken('a08_durum_alt') ]-> [ Out(k) ]

/* ---------------- sabitleme (R5): sabit artefaktın imzacı anahtarları bant dışı güvenilir ---------------- */
rule Pin_a01_lotl:
    [ !Sk('a01_lotl', t, k) ] --> [ !Acc('a01_lotl', pk(k), t) ]
rule Pin_a02_lote_pid:
    [ !Sk('a02_lote_pid', t, k) ] --> [ !Acc('a02_lote_pid', pk(k), t) ]

/* ---------------- tanıtma (R1 zinciri; her tanıtıcı bir OR-kenarıdır: R1 X_alt_ca) ---------------- */
rule Intro_a01_lotl__a02_tl:
    let m = <'intro', 'a01_lotl', 'a02_tl', pk(kA), tA> in
    [ !Sk('a01_lotl', tB, kB), !Sk('a02_tl', tA, kA) ] --> [ Out(<m, sign(m, kB)>) ]
rule AccIntro_a01_lotl__a02_tl_main:
    [ !Acc('a01_lotl', pkB, 'main'), In(<<'intro', 'a01_lotl', 'a02_tl', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a01_lotl', 'a02_tl', pkA, tA>, pkB), true) ]->
    [ !Acc('a02_tl', pkA, tA) ]
/* a01_lotl'nin 'alt' kullanımı yok: taşıyıcısı a00_ojeu özgün (R2 EXPECT_AUTH) */
rule Intro_a02_lote_pid__a03_ca:
    let m = <'intro', 'a02_lote_pid', 'a03_ca', pk(kA), tA> in
    [ !Sk('a02_lote_pid', tB, kB), !Sk('a03_ca', tA, kA) ] --> [ Out(<m, sign(m, kB)>) ]
rule AccIntro_a02_lote_pid__a03_ca_main:
    [ !Acc('a02_lote_pid', pkB, 'main'), In(<<'intro', 'a02_lote_pid', 'a03_ca', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a02_lote_pid', 'a03_ca', pkA, tA>, pkB), true) ]->
    [ !Acc('a03_ca', pkA, tA) ]
/* a02_lote_pid'nin 'alt' kullanımı yok: taşıyıcısı a00_ojeu özgün (R2 EXPECT_AUTH) */
rule Intro_a02_tl__a03_ca:
    let m = <'intro', 'a02_tl', 'a03_ca', pk(kA), tA> in
    [ !Sk('a02_tl', tB, kB), !Sk('a03_ca', tA, kA) ] --> [ Out(<m, sign(m, kB)>) ]
rule AccIntro_a02_tl__a03_ca_main:
    [ !Acc('a02_tl', pkB, 'main'), In(<<'intro', 'a02_tl', 'a03_ca', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a02_tl', 'a03_ca', pkA, tA>, pkB), true) ]->
    [ !Acc('a03_ca', pkA, tA) ]
rule AccIntro_a02_tl__a03_ca_alt:
    [ !Acc('a02_tl', pkB, 'alt'), !ExpVal('a01_lotl', 'a02_tl', 'none'), In(<<'intro', 'a02_tl', 'a03_ca', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a02_tl', 'a03_ca', pkA, tA>, pkB), true) ]->
    [ !Acc('a03_ca', pkA, tA) ]
rule Intro_a03_ca__a04_ihr:
    let m = <'intro', 'a03_ca', 'a04_ihr', pk(kA), tA> in
    [ !Sk('a03_ca', tB, kB), !Sk('a04_ihr', tA, kA) ] --> [ Out(<m, sign(m, kB)>) ]
rule AccIntro_a03_ca__a04_ihr_main:
    [ !Acc('a03_ca', pkB, 'main'), In(<<'intro', 'a03_ca', 'a04_ihr', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a03_ca', 'a04_ihr', pkA, tA>, pkB), true) ]->
    [ !Acc('a04_ihr', pkA, tA) ]
rule AccIntro_a03_ca__a04_ihr_alt:
    [ !Acc('a03_ca', pkB, 'alt'), !ExpVal('a02_lote_pid', 'a03_ca', 'none'), In(<<'intro', 'a03_ca', 'a04_ihr', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a03_ca', 'a04_ihr', pkA, tA>, pkB), true) ]->
    [ !Acc('a04_ihr', pkA, tA) ]
rule Intro_a04_ihr__a05_meta:
    let m = <'intro', 'a04_ihr', 'a05_meta', pk(kA), tA> in
    [ !Sk('a04_ihr', tB, kB), !Sk('a05_meta', tA, kA) ] --> [ Out(<m, sign(m, kB)>) ]
rule AccIntro_a04_ihr__a05_meta:
    [ !Acc('a04_ihr', pkB, t), In(<<'intro', 'a04_ihr', 'a05_meta', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a04_ihr', 'a05_meta', pkA, tA>, pkB), true) ]->
    [ !Acc('a05_meta', pkA, tA) ]
rule Intro_a04_ihr__a08_durum:
    let m = <'intro', 'a04_ihr', 'a08_durum', pk(kA), tA> in
    [ !Sk('a04_ihr', tB, kB), !Sk('a08_durum', tA, kA) ] --> [ Out(<m, sign(m, kB)>) ]
rule AccIntro_a04_ihr__a08_durum:
    [ !Acc('a04_ihr', pkB, t), In(<<'intro', 'a04_ihr', 'a08_durum', pkA, tA>, s>) ]
  --[ Eq(verify(s, <'intro', 'a04_ihr', 'a08_durum', pkA, tA>, pkB), true) ]->
    [ !Acc('a08_durum', pkA, tA) ]

/* ---------------- beklenti (R2 EXPECT_AUTH / R3 kanal; politika p4) ---------------- */
/* (a00_ojeu, a01_lotl): OJEU özgün; 'none' beyanı üretilemez */
/* (a00_ojeu, a02_lote_pid): OJEU özgün; 'none' beyanı üretilemez */
rule ExpPub_a01_lotl__a02_tl:
    let m = <'exp', 'a01_lotl', 'a02_tl', 'pq_required'> in
    [ !Sk('a01_lotl', t, k) ] --> [ Out(<m, sign(m, k)>) ]
rule ExpAcc_a01_lotl__a02_tl_main:
    [ !Acc('a01_lotl', pkC, 'main'), In(<<'exp', 'a01_lotl', 'a02_tl', e>, s>) ]
  --[ Eq(verify(s, <'exp', 'a01_lotl', 'a02_tl', e>, pkC), true) ]->
    [ !ExpVal('a01_lotl', 'a02_tl', e) ]
/* a01_lotl'nin 'alt' kullanımı yok: taşıyıcısı a00_ojeu özgün (R2 EXPECT_AUTH) */
rule ExpPub_a02_lote_pid__a03_ca:
    let m = <'exp', 'a02_lote_pid', 'a03_ca', 'pq_required'> in
    [ !Sk('a02_lote_pid', t, k) ] --> [ Out(<m, sign(m, k)>) ]
rule ExpAcc_a02_lote_pid__a03_ca_main:
    [ !Acc('a02_lote_pid', pkC, 'main'), In(<<'exp', 'a02_lote_pid', 'a03_ca', e>, s>) ]
  --[ Eq(verify(s, <'exp', 'a02_lote_pid', 'a03_ca', e>, pkC), true) ]->
    [ !ExpVal('a02_lote_pid', 'a03_ca', e) ]
/* a02_lote_pid'nin 'alt' kullanımı yok: taşıyıcısı a00_ojeu özgün (R2 EXPECT_AUTH) */
rule ExpPub_a02_lote_pid__a05_meta:
    let m = <'exp', 'a02_lote_pid', 'a05_meta', 'pq_required'> in
    [ !Sk('a02_lote_pid', t, k) ] --> [ Out(<m, sign(m, k)>) ]
rule ExpAcc_a02_lote_pid__a05_meta_main:
    [ !Acc('a02_lote_pid', pkC, 'main'), In(<<'exp', 'a02_lote_pid', 'a05_meta', e>, s>) ]
  --[ Eq(verify(s, <'exp', 'a02_lote_pid', 'a05_meta', e>, pkC), true) ]->
    [ !ExpVal('a02_lote_pid', 'a05_meta', e) ]
/* a02_lote_pid'nin 'alt' kullanımı yok: taşıyıcısı a00_ojeu özgün (R2 EXPECT_AUTH) */
rule ExpPub_a05_meta__a08_durum:
    let m = <'exp', 'a05_meta', 'a08_durum', 'pq_required'> in
    [ !Sk('a05_meta', t, k) ] --> [ Out(<m, sign(m, k)>) ]
rule ExpAcc_a05_meta__a08_durum_main:
    [ !Acc('a05_meta', pkC, 'main'), In(<<'exp', 'a05_meta', 'a08_durum', e>, s>) ]
  --[ Eq(verify(s, <'exp', 'a05_meta', 'a08_durum', e>, pkC), true) ]->
    [ !ExpVal('a05_meta', 'a08_durum', e) ]
rule ExpAcc_a05_meta__a08_durum_alt:
    [ !Acc('a05_meta', pkC, 'alt'), !ExpVal('a02_lote_pid', 'a05_meta', 'none'), In(<<'exp', 'a05_meta', 'a08_durum', e>, s>) ]
  --[ Eq(verify(s, <'exp', 'a05_meta', 'a08_durum', e>, pkC), true) ]->
    [ !ExpVal('a05_meta', 'a08_durum', e) ]

/* ---------------- hedef G3 ---------------- */
rule Issue_Status:
    let stb = <'status', ~st> in
    [ !Sk('a08_durum', 'main', km), !Sk('a08_durum', 'alt', ka), Fr(~st) ] --[ IssuedStatus(~st) ]-> [ Out(<stb, sign(stb, km)>), Out(<stb, sign(stb, ka)>) ]
rule Accept_Status_main:
    [ !Acc('a08_durum', pkS, 'main'), In(<<'status', st>, s>) ]
  --[ Eq(verify(s, <'status', st>, pkS), true), AcceptStatus(st) ]->
    [ ]
rule Accept_Status_alt:
    [ !Acc('a08_durum', pkS, 'alt'), !ExpVal('a05_meta', 'a08_durum', 'none'), In(<<'status', st>, s>) ]
  --[ Eq(verify(s, <'status', st>, pkS), true), AcceptStatus(st) ]->
    [ ]

/* ================= lemmalar ================= */
lemma executable:
  exists-trace
  "Ex st #i #j. IssuedStatus(st) @ #i & AcceptStatus(st) @ #j"

lemma G3_status_soundness:
  "All st #j. AcceptStatus(st) @ #j ==> (Ex #i. IssuedStatus(st) @ #i & #i < #j)"

end
