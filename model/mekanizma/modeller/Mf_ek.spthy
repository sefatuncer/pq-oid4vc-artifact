theory Mf_Ek
begin

/*
 * =====================================================================
 *  PQ-OID4VC | Adım 7 görev 0 EK (Değişiklik 8) | M-f çevrimdışı ekinin
 *  YOLA DUYARLI tanımları: 2 × 2 düzen — TASLAK, koşulmadı (--prove YOK)
 * =====================================================================
 *  Soru: İş planı 7.1'deki çevrimdışı ek ("tekdüze doğrulayıcı durumu + sunset'te klasik
 *  anahtarın süresinin dolması"; R7 tanımları) sertifika yolu eklenince yol sınıfını da
 *  korur mu? Model Mf_yol'un OBJ kipinin (imzalı, yeniden oynatılabilir beklenti nesnesi;
 *  TL/LoTE önbelleği) SCOPE_PATH ve üç saldırı yüzeyiyle özdeş kopyasıdır; yalnız iki
 *  eksen bayraklıdır.
 *  Tekdüzelik (tam olarak biri):
 *    MONOTONE_DAR    R7 tanımı: 'pq_required' görüldükten sonra klasik YAPRAK kabul edilmez.
 *    MONOTONE_GENIS  yola duyarlı: 'pq_required' görüldükten sonra 'none' beklentisi hiç
 *                    kullanılmaz (klasik kenarlı PQ yol da kapanır).
 *  Sunset (tam olarak biri):
 *    SUNSET_ANAHTAR  R7 / iş planı tanımı: klasik ihraççı anahtarı sunset'te sona erer
 *                    (TS 119 312 §8.4 takvimi, T036/T037).
 *    SUNSET_BEKLENTI yola duyarlı: 'none' beklentisi varlığın sunset'inden sonra kullanılmaz
 *                    (sunset anı 'none' kaydında önceden ilan edilmiş; koşul).
 *  Saldırı yüzeyleri: ATK_DIFF / ATK_SAME / ATK_ROOT (ön kayıtta üçü birlikte).
 */

builtins: signing

restriction Equality:   "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Inequality: "All x #i. NotEq(x, x) @ #i ==> F"
restriction Unique:     "All x #i #j. Unique(x) @ #i & Unique(x) @ #j ==> #i = #j"

restriction ClassicalIssuanceUntilSunset:
  "All X #i. IssueClassical(X) @ #i ==> not (Ex #s. Sunset(X) @ #s & #s < #i)"
restriction PQIssuanceAfterMigrate:
  "All X #i. IssuePQ(X) @ #i ==> (Ex #m. Migrate(X) @ #m & #m < #i)"

#ifdef MONOTONE_DAR
restriction StickyNarrow:
  "All V I c #k #j. SeenPQReq(V, I) @ #k & AcceptClassical(V, I, c) @ #j ==> #j < #k"
#endif

#ifdef MONOTONE_GENIS
restriction StickyWide:
  "All V I #k #j. SeenPQReq(V, I) @ #k & UseNone(V, I) @ #j ==> #j < #k"
#endif

#ifdef SUNSET_ANAHTAR
restriction ClassicalKeyExpiry:
  "All I #j. UseClKey(I) @ #j ==> not (Ex #s. Sunset(I) @ #s & #s < #j)"
#endif

#ifdef SUNSET_BEKLENTI
restriction NoneExpiresAtSunset:
  "All V I #j. UseNone(V, I) @ #j ==> not (Ex #s. Sunset(I) @ #s & #s < #j)"
#endif

#include "ortak_g5.spthy"

/* ---------------- Q-day ve CRQC (beklenti kaynağının anahtarı PQ; kırılmaz) ---------------- */
rule Qday:
    [ ] --[ Unique('qday'), QdayEv() ]-> [ !CRQC() ]

rule CRQC_Break_Issuer_Classical:
    [ !IssCl(X, k), !CRQC(), In(pk(k)) ] --[ Broken(<'iss_cl', X>) ]-> [ Out(k) ]

rule CRQC_Break_Classical_Anchor:
    [ !ClAnchorSk(A, k), !CRQC(), In(pk(k)) ] --[ Broken(<'anchor', A>) ]-> [ Out(k) ]

/* ---------------- TL'de listelenen çıpalar ---------------- */
rule CAM_Setup:
    [ Fr(~kcam) ]
  --[ Unique('setup_cam') ]->
    [ !CASk('CAM', ~kcam), !Anchor('CAM', pk(~kcam), 'pq'), Out(pk(~kcam)) ]

#ifdef ATK_DIFF
rule AltCA_Setup:
    [ Fr(~ka) ]
  --[ Unique('setup_alt_ca') ]->
    [ !ClAnchorSk('CAA', ~ka), !Anchor('CAA', pk(~ka), 'cl'), Out(pk(~ka)) ]
#endif

#ifdef ATK_SAME
rule OldCAM_Setup:
    [ Fr(~ko) ]
  --[ Unique('setup_old_cam') ]->
    [ !ClAnchorSk('CAM', ~ko), !Anchor('CAM', pk(~ko), 'cl'), Out(pk(~ko)) ]
#endif

#ifdef ATK_ROOT
rule ClassicalRoot_Setup:
    [ Fr(~kr) ]
  --[ Unique('setup_cl_root') ]->
    [ !ClAnchorSk('ROOT', ~kr), !Anchor('ROOT', pk(~kr), 'cl'), Out(pk(~kr)) ]
#endif

/* ---------------- ihraççılar ve yaşam döngüsü ---------------- */
rule Issuer_Setup_Born:
    let cc = <'iss_cert', $I, pk(~kc), 'cl'>
        cq = <'iss_cert', $I, pk(~kq), 'pq'>
    in
    [ !CASk('CAM', kcam), Fr(~kc), Fr(~kq) ]
  --[ Unique(<'iss', $I>), Unique(<'migrate', $I>), BornMigrated($I), Migrate($I), StateChange($I) ]->
    [ !IssCl($I, ~kc), !IssPQ($I, ~kq), !PinCl($I, pk(~kc)), !PinPQ($I, pk(~kq)),
      Out(pk(~kc)), Out(pk(~kq)), Out(<cc, sign(cc, kcam)>), Out(<cq, sign(cq, kcam)>) ]

rule Issuer_Setup_Migrating:
    let cc = <'iss_cert', $I, pk(~kc), 'cl'>
        cq = <'iss_cert', $I, pk(~kq), 'pq'>
    in
    [ !CASk('CAM', kcam), Fr(~kc), Fr(~kq) ]
  --[ Unique(<'iss', $I>), MigratingIssuer($I) ]->
    [ !IssCl($I, ~kc), !IssPQ($I, ~kq), !PinCl($I, pk(~kc)), !PinPQ($I, pk(~kq)),
      Out(pk(~kc)), Out(pk(~kq)), Out(<cc, sign(cc, kcam)>), Out(<cq, sign(cq, kcam)>) ]

rule Issuer_Setup_Legacy:
    let cc = <'iss_cert', $L, pk(~kc), 'cl'> in
    [ !CASk('CAM', kcam), Fr(~kc) ]
  --[ Unique(<'iss', $L>), Legacy($L) ]->
    [ !IssCl($L, ~kc), !PinCl($L, pk(~kc)), Out(pk(~kc)), Out(<cc, sign(cc, kcam)>) ]

rule Migrate:
    [ !IssPQ(I, kq) ] --[ Unique(<'migrate', I>), Migrate(I), StateChange(I) ]-> [ ]

rule Sunset:
    [ !IssPQ(I, kq) ] --[ Unique(<'sunset', I>), Sunset(I), StateChange(I) ]-> [ ]

rule Issue_Classical:
    let crb = <'cred', X, ~c> in
    [ !IssCl(X, kc), Fr(~c) ] --[ Issued(X, ~c), IssueClassical(X) ]-> [ Out(<crb, sign(crb, kc)>) ]

rule Issue_PQ:
    let crb = <'cred', I, ~c> in
    [ !IssPQ(I, kq), Fr(~c) ] --[ Issued(I, ~c), IssuePQ(I) ]-> [ Out(<crb, sign(crb, kq)>) ]

/* ---------------- beklenti kaynağı (TL/LoTE; PQ imzalı, yeniden oynatılabilir nesne) ---------------- */
rule Source_Setup:
    [ Fr(~ks) ] --[ Unique('src') ]-> [ !SrcSk(~ks), !SrcPin(pk(~ks)), Out(pk(~ks)) ]

rule Source_Publish_None:
    let ob = <'exp', I, 'none'> in
    [ !SrcSk(k), !PinCl(I, pkc) ] --[ StateIs(I, 'none') ]-> [ Out(<ob, sign(ob, k)>) ]

rule Source_Publish_PQ:
    let ob = <'exp', I, 'pq_required'> in
    [ !SrcSk(k), !PinPQ(I, pkq) ] --[ StateIs(I, 'pq_required') ]-> [ Out(<ob, sign(ob, k)>) ]

rule Source_Publish_Retired:
    let ob = <'exp', I, 'retired'> in
    [ !SrcSk(k), !PinPQ(I, pkq) ] --[ StateIs(I, 'retired') ]-> [ Out(<ob, sign(ob, k)>) ]

/* ---------------- doğrulayıcı oturumu ---------------- */
rule Verifier_Start:
    [ Fr(~sid) ] --> [ VS($V, ~sid, $I) ]

rule Exp_Obj_None:
    let ob = <'exp', I, 'none'> in
    [ VS(V, sid, I), !SrcPin(pks), In(<ob, os>) ]
  --[ Eq(verify(os, ob, pks), true) ]-> [ Exp(V, sid, I, 'none') ]

rule Exp_Obj_Req:
    let ob = <'exp', I, e> in
    [ VS(V, sid, I), !SrcPin(pks), In(<ob, os>) ]
  --[ Eq(verify(os, ob, pks), true), NotEq(e, 'none'), SeenPQReq(V, I) ]-> [ Exp(V, sid, I, e) ]

/* ===================== kabul: derinlik 1 ===================== */

rule Acc1_Classical:
    let isb = <'iss_cert', I, pkI, 'cl'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, 'none'), !Anchor(A, pkA, aA), In(<isb, s2>), In(<crb, s3>) ]
  --[ Eq(verify(s2, isb, pkA), true), Eq(verify(s3, crb, pkI), true),
      UseNone(V, I), UseClKey(I), Accept(V, I, c), AcceptClassical(V, I, c) ]->
    [ ]

rule Acc1_PQ_NoExp:
    let isb = <'iss_cert', I, pkI, 'pq'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, 'none'), !Anchor(A, pkA, aA), In(<isb, s2>), In(<crb, s3>) ]
  --[ Eq(verify(s2, isb, pkA), true), Eq(verify(s3, crb, pkI), true),
      UseNone(V, I), Accept(V, I, c), AcceptPQ(V, I, c), EdgeAlg(V, I, c, aA) ]->
    [ ]

/* yol_sinifi kapsamı */
rule Acc1_PQ_Exp:
    let isb = <'iss_cert', I, pkI, 'pq'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, e), !Anchor(A, pkA, 'pq'), In(<isb, s2>), In(<crb, s3>) ]
  --[ NotEq(e, 'none'), Eq(verify(s2, isb, pkA), true), Eq(verify(s3, crb, pkI), true),
      Accept(V, I, c), AcceptPQ(V, I, c), EdgeAlg(V, I, c, 'pq') ]->
    [ ]

/* ===================== kabul: derinlik 2 ===================== */

rule Acc2_Classical:
    let inb = <'int_cert', N, pkN, aN>
        isb = <'iss_cert', I, pkI, 'cl'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, 'none'), !Anchor(A, pkA, aA), In(<inb, s1>), In(<isb, s2>), In(<crb, s3>) ]
  --[ Eq(verify(s1, inb, pkA), true), Eq(verify(s2, isb, pkN), true), Eq(verify(s3, crb, pkI), true),
      UseNone(V, I), UseClKey(I), Accept(V, I, c), AcceptClassical(V, I, c) ]->
    [ ]

rule Acc2_PQ_NoExp:
    let inb = <'int_cert', N, pkN, aN>
        isb = <'iss_cert', I, pkI, 'pq'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, 'none'), !Anchor(A, pkA, aA), In(<inb, s1>), In(<isb, s2>), In(<crb, s3>) ]
  --[ Eq(verify(s1, inb, pkA), true), Eq(verify(s2, isb, pkN), true), Eq(verify(s3, crb, pkI), true),
      UseNone(V, I), Accept(V, I, c), AcceptPQ(V, I, c), EdgeAlg(V, I, c, aA), EdgeAlg(V, I, c, aN) ]->
    [ ]

rule Acc2_PQ_Exp:
    let inb = <'int_cert', N, pkN, 'pq'>
        isb = <'iss_cert', I, pkI, 'pq'>
        crb = <'cred', I, c>
    in
    [ Exp(V, sid, I, e), !Anchor(A, pkA, 'pq'), In(<inb, s1>), In(<isb, s2>), In(<crb, s3>) ]
  --[ NotEq(e, 'none'), Eq(verify(s1, inb, pkA), true), Eq(verify(s2, isb, pkN), true),
      Eq(verify(s3, crb, pkI), true),
      Accept(V, I, c), AcceptPQ(V, I, c), EdgeAlg(V, I, c, 'pq') ]->
    [ ]

/* ================= sağlık lemmaları (H0) ================= */

lemma executable:
  exists-trace
  "Ex V I c #m #j. Migrate(I) @ #m & AcceptPQ(V, I, c) @ #j & #m < #j"

lemma executable_legacy:
  exists-trace
  "Ex V L c #l #j. Legacy(L) @ #l & AcceptClassical(V, L, c) @ #j"

lemma executable_pre_migration:
  exists-trace
  "Ex V I c #s #j. MigratingIssuer(I) @ #s & AcceptClassical(V, I, c) @ #j
                 & not (Ex #m. Migrate(I) @ #m)"

lemma executable_lifecycle:
  exists-trace
  "Ex V I c #m #s #j. Migrate(I) @ #m & Sunset(I) @ #s & AcceptPQ(V, I, c) @ #j & #s < #j"

lemma executable_learn:
  exists-trace
  "Ex V I #k. SeenPQReq(V, I) @ #k"

lemma attack_needs_crqc:
  "All V I c #m #j. Migrate(I) @ #m & Accept(V, I, c) @ #j & #m < #j ==>
      (Ex #i. Issued(I, c) @ #i & #i < #j) | (Ex k #b. Broken(k) @ #b & #b < #j)"

/* ================= güvenlik ================= */

lemma G1_claims_unforgeability:
  "All V I c #m #j. Migrate(I) @ #m & Accept(V, I, c) @ #j & #m < #j ==>
      (Ex #i. Issued(I, c) @ #i & #i < #j)"

lemma G5_path_untimed:
  "All V I c #b #j. BornMigrated(I) @ #b & AcceptPQ(V, I, c) @ #j & EdgeAlg(V, I, c, 'cl') @ #j ==> F"

lemma G5_path_migrated:
  "All V I c #m #j. Migrate(I) @ #m & AcceptPQ(V, I, c) @ #j & EdgeAlg(V, I, c, 'cl') @ #j
      & #m < #j ==> F"

lemma G5_path_timed:
  "All V I c #s #j. Sunset(I) @ #s & AcceptPQ(V, I, c) @ #j & EdgeAlg(V, I, c, 'cl') @ #j
      & #s < #j ==> F"

lemma no_rollback_path:
  "All V I c #k #j. SeenPQReq(V, I) @ #k & AcceptPQ(V, I, c) @ #j & EdgeAlg(V, I, c, 'cl') @ #j
      & #k < #j ==> F"

/* ================= atıf (mutasyon) lemmaları ================= */

lemma M_downgrade_s1:
  exists-trace
  "Ex V I c #m #j. Migrate(I) @ #m & AcceptClassical(V, I, c) @ #j & #m < #j
                 & not (Ex #q. QdayEv() @ #q)"

lemma M_forgery_crqc:
  exists-trace
  "Ex V I c k #m #j #b. Migrate(I) @ #m & Accept(V, I, c) @ #j & #m < #j
                      & Broken(k) @ #b & not (Ex #i. Issued(I, c) @ #i)"

lemma M_weak_path_forgery:
  exists-trace
  "Ex V I c k #m #j #b. Migrate(I) @ #m & AcceptPQ(V, I, c) @ #j & EdgeAlg(V, I, c, 'cl') @ #j
                      & #m < #j & Broken(k) @ #b & not (Ex #i. Issued(I, c) @ #i)"

end
